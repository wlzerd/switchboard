# Switchboard 환경 변수
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 .gitignore 에 포함되어 커밋되지 않습니다.
# 비어 있는 값은 아래 주석의 기본값을 씁니다. 필수 항목이 비어 있으면 서버가 어떤 값이 왜 잘못됐는지 알려주고 멈춥니다.

# ─── 서버 ───────────────────────────────────────────────
# 0.0.0.0 이면 같은 네트워크 어디서든 접속할 수 있습니다. 외부에 공개할 때는 HTTPS 리버스 프록시 뒤에 두세요.
HOST=0.0.0.0
PORT=8787
# 개발 모드(npm run dev)에서 웹 화면을 띄우는 포트
WEB_DEV_PORT=5173
# 외부에서 접속하는 주소 (예: https://agents.example.com). 설정하면 쿠키에 Secure 가 붙습니다.
PUBLIC_URL=
# 리버스 프록시(Caddy, Nginx, Cloudflare Tunnel 등) 뒤에서 실행하면 true
TRUST_PROXY=false
# 서버 시간대. 일일 토큰 한도와 예약 실행 시각 계산에 씁니다.
TZ=Asia/Seoul
# debug | info | warn | error
LOG_LEVEL=info

# ─── 로그인 ─────────────────────────────────────────────
# 관리자 비밀번호 (12자 이상, 필수)
ADMIN_PASSWORD=
# 세션 서명용 임의 문자열 (32자 이상, 필수). 예: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=168
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ─── 저장소 ─────────────────────────────────────────────
# DB, 에이전트 작업 폴더, 설치한 모듈, 에이전트가 만든 스킬이 저장되는 곳
DATA_DIR=./data
# UI에서 직접 입력한 API 키를 암호화하는 32바이트 키 (base64, 필수). 예: openssl rand -base64 32
SECRETS_KEY=

# ─── Anthropic ──────────────────────────────────────────
# 에이전트를 만들 때 ".env 기본 키" 로 선택되는 키. 비워 두면 UI에서 키를 직접 입력해야 합니다.
ANTHROPIC_API_KEY=
# 프록시나 게이트웨이를 쓸 때만 설정
ANTHROPIC_BASE_URL=
ANTHROPIC_TIMEOUT_MS=600000
ANTHROPIC_MAX_RETRIES=2
# 키 확인(모델 목록 조회) 제한 시간
MODELS_TIMEOUT_MS=10000
# 모델 목록을 다시 불러오기 전까지 보관하는 시간(분)
MODELS_CACHE_MINUTES=60
# 안전 분류기가 요청을 거절했을 때 서버 측 대체 모델로 다시 시도합니다. default | off
ANTHROPIC_REFUSAL_FALLBACK=default
# 한 번의 응답에서 허용하는 최대 출력 토큰
AGENT_MAX_TOKENS=64000
# 긴 대화를 서버 측에서 요약(compaction)합니다. auto 는 모델이 지원할 때만 켭니다. auto | off
AGENT_COMPACTION=auto

# ─── 에이전트 실행 ──────────────────────────────────────
# 서버 전체에서 동시에 돌 수 있는 작업 수
AGENT_MAX_CONCURRENCY=4
# "확인" 권한 요청을 기다리는 시간. 지나면 거부로 처리합니다.
APPROVAL_TIMEOUT_MINUTES=30
# 서버 측 요약을 지원하지 않는 모델에서 보관할 최대 메시지 수
HISTORY_MAX_MESSAGES=200
SHELL_TIMEOUT_MS=60000
SHELL_OUTPUT_MAX_BYTES=65536
HTTP_TOOL_TIMEOUT_MS=20000
HTTP_TOOL_MAX_BYTES=262144

# ─── 모듈 ───────────────────────────────────────────────
# 기본 제공 모듈(Discord, Telegram) 폴더
MODULES_DIR=./modules
# 모듈 템플릿 폴더
TEMPLATES_DIR=./templates
MODULE_CALL_TIMEOUT_MS=30000
# 도구만 제공하는 모듈은 이 시간 동안 호출이 없으면 프로세스를 내립니다.
MODULE_IDLE_TIMEOUT_MS=600000
# 모듈 프로세스가 비정상 종료되면 다시 띄웁니다. 아래 시간 안에 이 횟수를 넘으면 멈춥니다.
MODULE_RESTART_MAX=5
MODULE_RESTART_WINDOW_MINUTES=10
# permission: Node 권한 모델로 모듈의 파일·프로세스 접근을 제한합니다. none: 제한하지 않습니다.
MODULE_SANDBOX=permission
GIT_BIN=git

# ─── 기본 금지 조항 임계값 ──────────────────────────────
# 에이전트 하나가 1분 안에 보낼 수 있는 메시지 수
GUARD_FLOOD_PER_MINUTE=20
# 같은 도구를 같은 입력으로 연속 호출할 수 있는 횟수
GUARD_LOOP_REPEAT=5

# ─── 기본 모듈 ──────────────────────────────────────────
# Discord 개발자 포털 > Bot 에서 발급. Message Content Intent 를 켜야 메시지를 읽을 수 있습니다.
DISCORD_BOT_TOKEN=
# Telegram @BotFather 에서 발급
TELEGRAM_BOT_TOKEN=

# ─── 사용자 훅에서 참조하는 값 ──────────────────────────
# 훅 조건에서 $env:QUIET_HOURS 로 참조합니다. 형식 HH:MM-HH:MM
QUIET_HOURS=22:00-08:00
