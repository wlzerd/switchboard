{
  "id": "watch",
  "name": "주기 실행",
  "version": "0.1.0",
  "description": "정해진 간격으로 웹 페이지를 확인하고 내용이 바뀌면 연결된 에이전트에게 알립니다.",
  "kind": "module",
  "entry": "index.js",
  "license": "MIT",
  "author": "",
  "icon": "clock",
  "channel": { "label": "주기 실행" },
  "env": [
    { "name": "WATCH_URL", "required": true, "description": "확인할 주소 (https://...)" },
    { "name": "WATCH_INTERVAL_MINUTES", "required": false, "description": "확인 간격(분). 기본 60" }
  ],
  "permissions": { "net": ["*"], "fsWrite": true, "childProcess": false },
  "tools": []
}
